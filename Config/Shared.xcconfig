// Settings shared by the app and the Finder extension.

MARKETING_VERSION = 1.3.4
CURRENT_PROJECT_VERSION = 9

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_TREAT_WARNINGS_AS_ERRORS = NO
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// Signing: ad-hoc by default, so anyone can build without an Apple account.
// Put your own identity in Config/Local.xcconfig (ignored by git), for example:
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = ABCDE12345
// A stable identity keeps the Accessibility permission across rebuilds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
