<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PrettyFolder</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The Finder extension reaches the app through prettyfolder:// URLs. The scheme has to
	     be claimed here: Launch Services refuses a sandboxed extension's request otherwise,
	     even when it names the app directly. Who sent a request is checked in AppDelegate. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prettyfolder</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Narek. MIT License.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>PrettyFolder changes the icons of folders on your Desktop when you ask it to.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>PrettyFolder changes the icons of folders in Documents when you ask it to.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>PrettyFolder changes the icons of folders in Downloads when you ask it to.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>PrettyFolder changes the icons of folders on external drives when you ask it to.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>PrettyFolder changes the icons of folders on network drives when you ask it to.</string>
	<key>NSFileProviderDomainUsageDescription</key>
	<string>PrettyFolder changes the icons of folders in iCloud Drive and other cloud storage when you ask it to.</string>
</dict>
</plist>
